    {
      "parameters": {
        "jsCode": "const s = $('Decidir estado de la sesión').first().json;\nconst tel = s.telefono;\nconst texto = s.texto.trim();\n\n// apartados de esta persona: comparación exacta de las 9 últimas cifras\nconst propios = $input.all()\n  .map(i => i.json)\n  .filter(a => tel !== '' && String(a.telefono ?? '').replace(/\\D/g, '').slice(-9) === tel);\n\n// sesión activa: ya verificada. Si no, vale si alguno de los números del texto es de un apartado de esta persona\nconst nums = (texto.match(/\\d+/g) ?? []).filter(n => n.length <= 6);\nconst idOk = nums.some(n => propios.some(a => a.id === Number(n)));\nconst verificado = s.estado === 'activa' || idOk;\n\nconst apartados = propios\n  .filter(a => a.estado === 'activo')\n  .map(a => ({ producto: a.producto, pendiente: a.pendiente, fecha_limite: a.fecha_limite }));\n\nreturn [{ json: { chat_id: s.chat_id, verificado, apartados } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
