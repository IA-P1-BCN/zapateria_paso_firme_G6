    {
      "parameters": {
        "jsCode": "const msg = $('Leer mensaje').first().json;\nconst fila = $input.first().json; // vacío si el chat no tiene fila\nconst DIEZ_MIN = 10 * 60 * 1000;\nconst vigente = (fecha) => Date.now() - new Date(fecha).getTime() <= DIEZ_MIN;\n\nlet estado = 'sin_sesion';\nif (fila.id) {\n  // pendiente: caduca a los 10 min de crearse; verificada: a los 10 min de la última actividad\n  const referencia = fila.verificado_en ? fila.verificado_en : fila.createdAt;\n  if (vigente(referencia)) {\n    estado = fila.verificado_en ? 'activa' : 'esperando_apartado';\n  }\n}\n\nreturn [{ json: { ...msg, estado, telefono: fila.telefono ?? '', fila_id: fila.id ?? null } }];"
      },
