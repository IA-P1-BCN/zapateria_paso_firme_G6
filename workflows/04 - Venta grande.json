                  {
                      "parameters":  {
                                         "jsCode":  "const input = $input.first().json;\nconst d = input.datos ?? input.body?.datos ?? input.body ?? input;\n\nconst umbral = Number(String($env.UMBRAL_VENTA_GRANDE ?? \u0027\u0027).replace(\u0027,\u0027, \u0027.\u0027));\nif (!Number.isFinite(umbral) || umbral \u003c= 0) {\n  throw new Error(\u0027UMBRAL_VENTA_GRANDE no está configurado o no es un número\u0027);\n}\n\nconst importe = Number(d.importe);\nif (!Number.isFinite(importe)) {\n  throw new Error(\u0027La venta no trae un importe válido\u0027);\n}\n\nconst fmt = (c) =\u003e\n  `${(c / 100).toLocaleString(\u0027es-ES\u0027, {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  })} €`;\n\nconst centimos = Math.round(importe * 100);\nconst esGrande = centimos \u003e= Math.round(umbral * 100);\n\nconst concepto = String(d.concepto ?? \u0027sin concepto\u0027);\nconst forma = String(d.forma_pago ?? \u0027sin especificar\u0027);\n\nconst mensaje =\n`Venta grande registrada.\nConcepto: ${concepto}\nImporte: ${fmt(centimos)}\nForma de pago: ${forma}\nUmbral configurado: ${fmt(Math.round(umbral * 100))}`;\n\nreturn [{\n  json: {\n    ...d,\n    esGrande,\n    destinatario: \u0027tienda\u0027,\n    email: \u0027\u0027,\n    asunto: `Venta grande: ${fmt(centimos)}`,\n    contexto: `Venta ${d.id ?? \u0027sin número\u0027} - ${concepto}`,\n    mensaje\n  }\n}];"
                                     },
