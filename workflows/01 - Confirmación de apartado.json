      "name": "¿Está liquidado?",
      "id": "97e26c24-2849-4672-b984-2b310bee018c",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst mensaje = `Hola, ${d.cliente ?? 'cliente'}. Tu apartado de ${d.producto ?? 'producto'}, talla ${d.talla ?? 'no especificada'} está completamente abonado y ya puedes pasar a recogerlo.\\n¡Gracias por confiar en Paso Firme!`;\n\nreturn [{ json: { ...d, mensaje } }];"
      },
      "position": [
        1024,
        -192
      ],
      "name": "Crear mensaje de recogida",
      "id": "8bd3cac6-a58f-4d59-92dd-3c67ee1ef745",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst mensaje = [\n  `Hola, ${d.cliente ?? 'cliente'}. Hemos registrado tu apartado de ${d.producto ?? 'producto'}, talla ${d.talla ?? 'no especificada'}.`,\n  `Precio total: ${d.precioFormato}`,\n  `Abonado: ${d.abonadoFormato}`,\n  `Pendiente: ${d.pendienteFormato}`,\n  `Fecha límite para recogerlo: ${d.fechaLimiteFormato}.`,\n  '¡Gracias por confiar en Paso Firme!'\n].join('\\n');\n\nreturn [{ json: { ...d, mensaje } }];"
      },
