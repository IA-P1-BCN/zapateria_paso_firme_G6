        272,
        -80
      ],
      "name": "Recibir apartado",
      "id": "aa84d259-ec6a-4b8d-b2a5-93c9d0a19f37",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Obtener los datos del apartado según la estructura recibida\nconst d = input.datos\n  ?? input.body?.datos\n  ?? input.body\n  ?? input;\n\n// Formatear importes en euros con coma decimal\nconst formatMoney = (value) => {\n  if (value === null || value === undefined || value === '') {\n    return '';\n  }\n\n  const n = Number(value);\n\n  if (!Number.isFinite(n)) {\n    return '';\n  }\n\n  return `${n.toLocaleString('es-ES', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  })} €`;\n};\n\n// Formatear fecha como dd/mm/aaaa\nconst formatDate = (value) => {\n  if (!value) {\n    return '';\n  }\n\n  const s = String(value).slice(0, 10);\n  const match = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n\n  return match\n    ? `${match[3]}/${match[2]}/${match[1]}`\n    : s;\n};\n\n// Preparar los datos para los siguientes nodos\nreturn [\n  {\n    json: {\n      ...d,\n\n      email: String(d.email ?? '').trim(),\n\n      esLiquidado:\n        String(d.estado ?? '').trim().toLowerCase() === 'liquidado',\n\n      destinatario: 'cliente',\n\n      asunto: `Confirmación de apartado ${d.id ?? ''}`.trim(),\n\n      contexto: `Apartado ${d.id ?? 'sin número'} - ${d.cliente ?? 'cliente'}`,\n\n      precioFormato: formatMoney(d.precio),\n      abonadoFormato: formatMoney(d.abonado),\n      pendienteFormato: formatMoney(d.pendiente),\n\n      fechaLimiteFormato: formatDate(d.fecha_limite)\n    }\n  }\n];"
      },
      "position": [
        512,
        -80
      ],
      "name": "Preparar datos y formatos",
      "id": "7714a9a5-3619-49b3-a20d-33d0d464e03c",
