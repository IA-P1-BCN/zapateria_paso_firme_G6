    {
      "id": "b2c3d4e5-0000-4000-8000-000000000012",
      "name": "Redactar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "jsCode": "const euros = n => `${Number(n).toFixed(2).replace('.', ',')} €`;\n\nfunction avisoResultado(r) {\n  const s = r.solicitud;\n  const quien = s ? `${s.cliente}, ${s.producto} T${s.talla}` : `solicitud nº ${r.numero ?? '?'}`;\n  if (r.creado) {\n    const a = r.apartado;\n    return { destinatario: 'tienda', email: '', contexto: `Solicitud ${s.id}`,\n      asunto: `Apartado #${a.id} creado desde la solicitud nº ${s.id}`,\n      mensaje: ['Hola, Marisa:', '', `Se ha creado el apartado #${a.id} (${quien}).`,\n        `Precio ${euros(a.precio)} · abonado ${euros(a.abonado)} · faltan ${euros(a.pendiente)} · vence el ${a.fecha_limite}.`,\n        s.email ? 'La clienta recibirá la confirmación del apartado por correo.' : 'La clienta no dejó correo: avísala tú.', '',\n        'Este aviso lo envía el flujo \"Confirmar solicitud de apartado\".'].join('\\n') };\n  }\n  return { destinatario: 'tienda', email: '', contexto: s ? `Solicitud ${s.id}` : 'Confirmación de solicitud',\n    asunto: `Apartado NO creado: ${quien}`,\n    mensaje: ['Hola, Marisa:', '', `No se ha creado el apartado (${quien}).`, `Motivo: ${r.motivo}.`, '',\n      'Revisa los datos y vuelve a enviar la confirmación.', '', 'Este aviso lo envía el flujo \"Confirmar solicitud de apartado\".'].join('\\n') };\n}\n\n// Tras \"Marcar como confirmada\" el item es la fila de la tabla: el resultado se toma de \"Comprobar creación\".\nreturn $input.all().map((i, k) => {\n  const r = i.json.accion ? i.json : $('Comprobar creación').all().filter(x => x.json.creado)[k].json;\n  return { json: avisoResultado(r) };\n});"
      }
    },
