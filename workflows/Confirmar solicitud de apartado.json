    {
      "id": "b2c3d4e5-0000-4000-8000-000000000009",
      "name": "Comprobar creación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 201: apartado creado. 422: la app lo rechaza (detail puede ser texto o lista). Otro código es un error.\nconst previo = $('Decidir confirmaciones').item.json;\nconst { statusCode, body } = $json;\nif (statusCode === 201) return { json: { ...previo, creado: true, apartado: body } };\nif (statusCode === 422) {\n  const d = body?.detail;\n  return { json: { ...previo, creado: false, motivo: `La app no lo acepta: ${typeof d === 'string' ? d : JSON.stringify(d)}` } };\n}\nthrow new Error(`La tienda respondió ${statusCode} al crear el apartado: ${JSON.stringify(body)}`);"
      }
    },
