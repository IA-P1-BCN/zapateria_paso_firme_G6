    {
      "id": "b2c3d4e5-0000-4000-8000-000000000002",
      "name": "Confirmaciones de ejemplo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Confirma la solicitud 1 (y la repite), la 2 con un abono por debajo del mínimo y una que no existe.\nreturn [\n  {\n    \"numero\": \"1\",\n    \"precio\": \"89,90\",\n    \"abono\": \"10\",\n    \"forma_pago\": \"bizum\"\n  },\n  {\n    \"numero\": \"1\",\n    \"precio\": \"89,90\",\n    \"abono\": \"10\",\n    \"forma_pago\": \"bizum\"\n  },\n  {\n    \"numero\": \"2\",\n    \"precio\": \"29,95\",\n    \"abono\": \"3\",\n    \"forma_pago\": \"efectivo\"\n  },\n  {\n    \"numero\": \"99\",\n    \"precio\": \"50\",\n    \"abono\": \"10\",\n    \"forma_pago\": \"efectivo\"\n  }\n].map(json => ({ json }));"
      }
    },
    {
      "id": "b2c3d4e5-0000-4000-8000-000000000003",
      "name": "Formulario de confirmación",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        220,
        200
      ],
      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "Confirmar una solicitud de apartado",
        "formDescription": "Solo para la tienda. Rellénalo cuando la clienta haya pagado el abono inicial.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Nº de solicitud",
              "fieldName": "numero",
              "requiredField": true,
              "fieldType": "number"
            },
            {
              "fieldLabel": "Precio (€)",
              "fieldName": "precio",
              "requiredField": true,
              "placeholder": "89,90"
            },
            {
              "fieldLabel": "Abono inicial (€)",
              "fieldName": "abono",
              "requiredField": true,
              "placeholder": "Mínimo 5"
            },
            {
              "fieldLabel": "Forma de pago",
              "fieldName": "forma_pago",
              "requiredField": true,
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "efectivo"
                  },
                  {
                    "option": "tarjeta"
                  },
                  {
                    "option": "bizum"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "confirmar-solicitud",
          "appendAttribution": false,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Recibido. Te llegará un correo con el resultado."
            }
          }
        }
      },
      "webhookId": "b8e4d3f2-6c5e-4f7a-9b0c-1d2e3f4a5b6c",
      "credentials": {
        "httpBasicAuth": {
          "id": "kEbxzKUk3CEjSmVS",
