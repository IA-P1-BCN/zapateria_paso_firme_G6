    {
      "id": "b2c3d4e5-0000-4000-8000-000000000004",
      "name": "Preparar confirmación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "jsCode": "const sinAcentos = s => String(s ?? '').normalize('NFD').replace(/\\p{M}/gu, '');\n\nconst clave = s => sinAcentos(s).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\n\n// Busca un campo del formulario por su nombre interno o por su etiqueta, sin depender de acentos ni mayúsculas.\nfunction campo(datos, ...nombres) {\n  const k = Object.keys(datos).find(c => nombres.includes(clave(c)));\n  return k === undefined ? '' : String(datos[k] ?? '').trim();\n}\n\nfunction numero(s) {\n  let t = String(s ?? '').replace(/[€\\s]/g, '');\n  if (t.includes(',')) t = t.replace(/\\./g, '').replace(',', '.');\n  return /^\\d+(\\.\\d+)?$/.test(t) ? Math.round(Number(t) * 100) / 100 : null;\n}\n\nfunction prepararConfirmacion(datos) {\n  return {\n    numero: numero(campo(datos, 'numero', 'n de solicitud', 'no de solicitud', 'numero de solicitud')),\n    precio: numero(campo(datos, 'precio')),\n    abono: numero(campo(datos, 'abono', 'abono inicial')),\n    forma_pago: clave(campo(datos, 'forma pago', 'forma de pago')),\n  };\n}\n\nreturn $input.all().map(i => ({ json: prepararConfirmacion(i.json) }));"
      }
    },
    {
      "id": "b2c3d4e5-0000-4000-8000-000000000005",
      "name": "Solicitudes guardadas",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        100
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "solicitudes_apartado"
        },
        "returnAll": true
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "b2c3d4e5-0000-4000-8000-000000000006",
      "name": "Decidir confirmaciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "jsCode": "const euros = n => `${Number(n).toFixed(2).replace('.', ',')} €`;\n\nconst MINIMO_ABONO = 5;\n\nconst FORMAS_PAGO = ['efectivo', 'tarjeta', 'bizum'];\n\nfunction decidirConfirmaciones(confirmaciones, guardadas) {\n  const confirmadasAhora = new Set();\n  return confirmaciones.map(c => {\n    const s = guardadas.find(g => Number(g.id) === c.numero);\n    const no = motivo => ({ ...c, solicitud: s ?? null, accion: 'rechazar', motivo });\n    if (!s) return no(`No existe la solicitud nº ${c.numero ?? '?'}`);\n    if (s.estado === 'confirmada' || confirmadasAhora.has(s.id)) {\n      return no(`La solicitud nº ${s.id} ya está confirmada${s.apartado_id ? ` (apartado #${s.apartado_id})` : ''}: no se crea otro apartado`);\n    }\n    if (c.precio === null || c.precio <= 0) return no('El precio no es un número mayor que 0');\n    if (c.abono === null || c.abono < MINIMO_ABONO) return no(`El abono inicial tiene que ser de al menos ${euros(MINIMO_ABONO)}`);\n    if (c.abono > c.precio) return no('El abono inicial no puede superar el precio');\n    if (!FORMAS_PAGO.includes(c.forma_pago)) return no('La forma de pago tiene que ser efectivo, tarjeta o bizum');\n    confirmadasAhora.add(s.id);\n    return { ...c, solicitud: s, accion: 'crear', motivo: '',\n      body: { cliente: s.cliente, telefono: s.telefono || null, email: s.email || null, producto: s.producto,\n              talla: s.talla, precio: c.precio, abono_inicial: c.abono, forma_pago: c.forma_pago } };\n  });\n}\n\n// Una solicitud ya confirmada (o confirmada antes en este mismo lote) no crea otro apartado.\nconst confirmaciones = $('Preparar confirmación').all().map(i => i.json);\nconst guardadas = $('Solicitudes guardadas').all().map(i => i.json).filter(g => g.id !== undefined);\nreturn decidirConfirmaciones(confirmaciones, guardadas).map(json => ({ json }));"
      },
      "executeOnce": true
    },
