      "name": "Abonos de hoy",
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "jdjCZLP8atMe7mDV",
          "name": "Tienda API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const hoy = $('Calcular hoy').first().json.hoy;\nconst ventas = $('Ventas de hoy').all();\nconst abonos = $('Abonos de hoy').all();\nconst formas = ['efectivo', 'tarjeta', 'bizum'];\n\nconst sumar = (items) => {\n  const t = { efectivo: 0, tarjeta: 0, bizum: 0 };\n  let n = 0;\n  for (const it of items) {\n    const r = it.json;\n    if (r.importe === undefined || r.importe === null) continue;\n    const forma = String(r.forma_pago ?? '').trim().toLowerCase();\n    if (!formas.includes(forma)) {\n      throw new Error(`Forma de pago desconocida: ${r.forma_pago}`);\n    }\n    t[forma] += Math.round(Number(r.importe) * 100);\n    n++;\n  }\n  return { t, n };\n};\n\nconst v = sumar(ventas);\nconst a = sumar(abonos);\n\nconst total = {};\nfor (const f of formas) total[f] = v.t[f] + a.t[f];\n\nconst suma = (o) => formas.reduce((s, f) => s + o[f], 0);\nconst fmt = (c) =>\n  `${(c / 100).toLocaleString('es-ES', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  })} €`;\n\nconst bloque = (titulo, o) =>\n  `${titulo}\\n` +\n  `  Efectivo: ${fmt(o.efectivo)}\\n` +\n  `  Tarjeta: ${fmt(o.tarjeta)}\\n` +\n  `  Bizum: ${fmt(o.bizum)}\\n` +\n  `  Total: ${fmt(suma(o))}`;\n\nconst hayMovimientos = v.n + a.n > 0;\nconst fechaFormato = hoy.split('-').reverse().join('/');\n\nconst mensaje = hayMovimientos\n  ? `Cierre del ${fechaFormato}\\n\\n` +\n    bloque('Ventas directas', v.t) + '\\n\\n' +\n    bloque('Abonos de apartados', a.t) + '\\n\\n' +\n    bloque('Total del día', total)\n  : `Cierre del ${fechaFormato}\\n\\nHoy no hubo movimientos.`;\n\nreturn [{\n  json: {\n    fecha: hoy,\n    hayMovimientos,\n    ventas_efectivo: v.t.efectivo / 100,\n    ventas_tarjeta: v.t.tarjeta / 100,\n    ventas_bizum: v.t.bizum / 100,\n    ventas_total: suma(v.t) / 100,\n    abonos_efectivo: a.t.efectivo / 100,\n    abonos_tarjeta: a.t.tarjeta / 100,\n    abonos_bizum: a.t.bizum / 100,\n    abonos_total: suma(a.t) / 100,\n    total_efectivo: total.efectivo / 100,\n    total_tarjeta: total.tarjeta / 100,\n    total_bizum: total.bizum / 100,\n    total: suma(total) / 100,\n    destinatario: 'tienda',\n    email: '',\n    asunto: `Cierre diario ${fechaFormato}`,\n    contexto: `Cierre diario ${hoy}`,\n    mensaje\n  }\n}];"
      },
