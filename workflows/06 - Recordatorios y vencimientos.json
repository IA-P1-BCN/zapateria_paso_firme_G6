    {
      "parameters": {
        "jsCode": "const memoria = $getWorkflowStaticData('global');\nmemoria.avisados = memoria.avisados || {};\nconst previos = $('Preparar recordatorio').all();\n\n$input.all().forEach((item, i) => {\n  if (item.json.enviado) {\n    const p = previos[i].json;\n    memoria.avisados[`${p.id}:${p.tipo}`] = true;\n  }\n});\n\nreturn $input.all().map(i => ({ json: i.json }));"
