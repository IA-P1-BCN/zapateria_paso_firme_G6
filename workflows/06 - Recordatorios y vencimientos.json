      "parameters": {
        "jsCode": "const salida = [];\nfor (const item of $input.all()) {\n  const { statusCode, body } = item.json;\n  if (statusCode === 200) {\n    salida.push({ json: body });\n  } else if (statusCode !== 422) {\n// 422 = ya no estaba activo: se ignora a propósito; cualquier otro código es un fallo real\n    throw new Error(`vencer respondió ${statusCode}: ${JSON.stringify(body)}`);\n  }\n}\nreturn salida;"
