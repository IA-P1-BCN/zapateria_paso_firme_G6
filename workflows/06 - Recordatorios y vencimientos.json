      "parameters": {
        "jsCode": "const hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Madrid' });\n\nfunction sumarDias(fecha, dias) {\n  const d = new Date(fecha + 'T00:00:00Z');\n  d.setUTCDate(d.getUTCDate() + dias);\n  return d.toISOString().slice(0, 10);\n}\n\nconst en7 = sumarDias(hoy, 7);\nconst en1 = sumarDias(hoy, 1);\n\nconst salida = [];\nfor (const item of $input.all()) {\n  const a = item.json;\n  let tipo = null;\n  if (a.fecha_limite === en7) tipo = 'recordatorio_7';\n  else if (a.fecha_limite === en1) tipo = 'recordatorio_1';\n  else if (a.fecha_limite < hoy) tipo = 'vencer';\n  if (tipo) salida.push({ json: { ...a, tipo } });\n}\nreturn salida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
