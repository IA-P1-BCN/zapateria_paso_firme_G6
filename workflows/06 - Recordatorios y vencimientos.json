        "jsCode": "const vencidos = $('Separar vencidos de errores').all().map(i => i.json.apartado);\nconst lineas = vencidos.map(a => `- ${a.cliente}: ${a.producto} (talla ${a.talla})`);\n\nreturn [{ json: {\n  destinatario: 'tienda',\n  email: '',\n  asunto: `Apartados vencidos hoy: ${vencidos.length}`,\n  mensaje: `Estos apartados han vencido hoy y los zapatos vuelven a estar a la venta:\\n\\n${lineas.join('\\n')}`,\n  contexto: 'Lista de apartados vencidos'\n} }];"
