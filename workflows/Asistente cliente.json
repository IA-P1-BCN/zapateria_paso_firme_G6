    {
      "parameters": {
        "jsCode": "const s = $('Decidir estado de la sesión').first().json;\nconst tel = s.telefono;\nconst texto = s.texto.trim();\n\n// apartados de esta persona: comparación exacta de las 9 últimas cifras\nconst propios = $input.all()\n  .map(i => i.json)\n  .filter(a => tel !== '' && String(a.telefono ?? '').replace(/\\D/g, '').slice(-9) === tel);\n\n// sesión activa: ya verificada. Si no, el número tecleado debe ser de un apartado suyo\nconst idOk = /^#?\\d{1,6}$/.test(texto)\n  && propios.some(a => a.id === Number(texto.replace('#', '')));\nconst verificado = s.estado === 'activa' || idOk;\n\nconst apartados = propios\n  .filter(a => a.estado === 'activo')\n  .map(a => ({ producto: a.producto, pendiente: a.pendiente, fecha_limite: a.fecha_limite }));\n\nreturn [{ json: { chat_id: s.chat_id, verificado, apartados } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
