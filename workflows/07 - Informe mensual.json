    {
      "parameters": {
        "jsCode": "const { desde, hasta, mes } = $('Calcular mes anterior').first().json;\nconst filas = (nombre) => $(nombre).all().map((i) => i.json).filter((r) => r.id !== undefined);\nconst ventas = filas('Ventas del mes');\nconst abonosTodos = filas('Abonos');\nconst apartados = filas('Apartados');\nconst vales = filas('Vales');\n\nconst enMes = (f) => f >= desde && f <= hasta;\nconst cent = (x) => Math.round(Number(x) * 100);\nconst total = (rows) => rows.reduce((s, r) => s + cent(r.importe), 0);\n\nconst abonosMes = abonosTodos.filter((a) => enMes(a.fecha));\nconst ventasC = total(ventas);\nconst abonosC = total(abonosMes);\n\nconst pendienteC = apartados\n  .filter((a) => a.estado === 'activo')\n  .reduce((s, a) => s + cent(a.pendiente), 0);\nconst nuevos = apartados.filter((a) => enMes(a.fecha)).length;\n\n// La app no guarda cuándo se liquidó: se usa la fecha de su último abono.\nconst ultimoAbono = {};\nfor (const a of abonosTodos) {\n  if (!ultimoAbono[a.apartado_id] || a.fecha > ultimoAbono[a.apartado_id]) {\n    ultimoAbono[a.apartado_id] = a.fecha;\n  }\n}\nconst liquidados = apartados.filter(\n  (a) => a.estado === 'liquidado' && ultimoAbono[a.id] && enMes(ultimoAbono[a.id])\n).length;\nconst vencidos = vales.filter((v) => enMes(v.fecha)).length;\n\nconst fmt = (c) =>\n  `${(c / 100).toLocaleString('es-ES', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  })} €`;\n\nconst mensaje =\n  `Informe de ${mes}\\n\\n` +\n  `Cobrado en el mes\\n` +\n  `  Ventas: ${fmt(ventasC)}\\n` +\n  `  Abonos: ${fmt(abonosC)}\\n` +\n  `  Total: ${fmt(ventasC + abonosC)}\\n\\n` +\n  `Pendiente de cobrar en apartados activos: ${fmt(pendienteC)}\\n\\n` +\n  `Apartados del mes\\n` +\n  `  Nuevos: ${nuevos}\\n` +\n  `  Liquidados: ${liquidados}\\n` +\n  `  Vencidos: ${vencidos}`;\n\nreturn [{\n  json: {\n    desde, hasta, mes,\n    ventas: ventasC / 100,\n    abonos: abonosC / 100,\n    total: (ventasC + abonosC) / 100,\n    pendiente_total: pendienteC / 100,\n    nuevos, liquidados, vencidos,\n    destinatario: 'tienda',\n    asunto: `Informe mensual ${mes}`,\n    contexto: `Informe mensual ${desde}`,\n    mensaje\n  }\n}];"
      },
