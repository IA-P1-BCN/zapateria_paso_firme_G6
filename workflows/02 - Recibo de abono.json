    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst mensaje =\n`Hola, ${d.cliente}. Hemos recibido tu último abono de ${d.importeFormato} y tu apartado de ${d.producto}, talla ${d.talla}, ya está pagado por completo.\nYa puedes pasar a recoger tus zapatos.\n¡Gracias por confiar en Paso Firme!`;\n\nreturn [{ json: { ...d, mensaje } }];"
      },
