      "name": "Recibir error"
    },
    {
      "parameters": {
        "jsCode": "const datos = $input.first().json;\nconst ejecucion = datos.execution ?? {};\nconst mensajeError = ejecucion.error?.message ?? datos.trigger?.error?.message ?? 'Error desconocido';\n\nconst limpiar = (texto) => String(texto)\n  .replace(/(x-api-key|authorization|api[-_]?key|token|password|contraseña)([\"']?\\s*[:=]\\s*)(Bearer\\s+)?[^\\s,;\"'}]+/gi, '$1$2[oculto]')\n  .replace(/Bearer\\s+[^\\s,;\"'}]+/gi, 'Bearer [oculto]');\n\nconst flujo = datos.workflow?.name ?? 'Flujo desconocido';\nconst nodo = ejecucion.lastNodeExecuted ?? 'Nodo desconocido';\nconst enlace = ejecucion.url ?? 'Sin enlace (el fallo ocurrió en el disparador)';\nconst hora = new Date().toLocaleString('es-ES', { timeZone: 'Europe/Madrid' });\n\nreturn [{\n  json: {\n    destinatario: 'tienda',\n    email: '',\n    asunto: `Fallo en el flujo: ${flujo}`,\n    mensaje: [\n      `El flujo \"${flujo}\" ha fallado.`,\n      `Paso que falló: ${nodo}`,\n      `Error: ${limpiar(mensajeError)}`,\n      `Hora: ${hora}`,\n      `Ejecución: ${enlace}`,\n    ].join('\\n'),\n    contexto: `${flujo} - ${nodo}`,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        -160
      ],
